rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // User profile pictures and avatars
    match /users/{userId}/avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Workspace exports (downloadable by workspace members)
    match /workspaces/{workspaceId}/exports/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Workspace imports (temporary upload area)
    match /workspaces/{workspaceId}/imports/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Team shared files and assets
    match /teams/{teamId}/assets/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Team workspace files
    match /teams/{teamId}/workspaces/{workspaceId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Temporary uploads for file processing
    match /temp/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // File uploads for specific workspaces
    match /uploads/{userId}/{workspaceId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}